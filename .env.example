# --- LLM providers (order =your_value_here
ANSWER_PROVIDERS=your_value_here
REWRITE_PROVIDERS=your_value_here
REWRITE_ENABLED=your_value_here
ANTHROPIC_API_KEY=your_value_here
CLAUDE_MODEL=your_value_here
GEMINI_API_KEY=your_value_here
# Model IDs retire often (gemini-2.5-* did). Copy a current Flash ID from https://aistudio.google.com
GEMINI_MODEL=your_value_here
# Optional local provider: add "ollama" to ANSWER_PROVIDERS
OLLAMA_URL=your_value_here
OLLAMA_MODEL=your_value_here

# --- Storage ---
DATABASE_URL=your_value_here
# Postgres: postgresql+psycopg2://rag:rag@localhost:5432/rag
QDRANT_URL=your_value_here
QDRANT_COLLECTION=your_value_here
UPLOAD_DIR=your_value_here

# --- Optional ---
API_KEY=your_value_here
LOG_LEVEL=your_value_here

# --- Paper discovery (all free) ---
# OpenAlex now requires a free key: https://openalex.org/settings/api  (free daily budget)
OPENALEX_API_KEY=your_value_here
CONTACT_EMAIL=your_value_here
UNPAYWALL_EMAIL=your_value_here
